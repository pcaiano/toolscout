{
  "version": 6,
  "principles": {
    "catalogMustStayMarketRelevant": true,
    "officialSourcesRequired": true,
    "affiliateEconomicsNeverAffectEditorialSelection": true,
    "automaticMutationsRequireQualityGates": true,
    "brokenOrUnverifiableToolsAreSuppressedAfterRepeatedFailure": true,
    "commercialRelationshipsAreStoredSeparatelyFromEditorialFit": true,
    "unsupportedClaimsMustNeverEnterEditorialRanking": true,
    "genericCategoryProfilesCannotCreateEditorialFacts": true,
    "catalogEntryDoesNotImplyRecommendation": true,
    "volatileFactsRequireFieldLevelFreshness": true,
    "visualAssetsArePartOfCatalogQuality": true,
    "catalogToolsUseSameRankingEligibilityRules": true
  },
  "cadence": {
    "run": "daily",
    "freshnessTargetDays": 7,
    "deepReviewDays": 30,
    "suppressAfterConfirmedBrokenRuns": 2
  },
  "coverage": {
    "minimumToolsPerIntentCategory": 5,
    "priorityCategories": [
      "crm",
      "marketing",
      "seo",
      "automation",
      "forms",
      "sales",
      "support",
      "social",
      "website",
      "analytics",
      "ai-research",
      "ai-assistant",
      "ai-writing",
      "developer",
      "ecommerce",
      "design",
      "content",
      "business"
    ]
  },
  "admission": {
    "requiredFields": [
      "slug",
      "name",
      "category",
      "description",
      "pricing",
      "freePlan",
      "features",
      "bestFor",
      "sourceUrl",
      "scores"
    ],
    "scoreKeys": [
      "price",
      "ease",
      "automation",
      "integrations",
      "sales",
      "ai",
      "marketing",
      "seo",
      "research",
      "content",
      "agency"
    ],
    "minimumFeatures": 3,
    "minimumBestFor": 2,
    "minimumDescriptionLength": 60,
    "requireReachableOfficialSource": true,
    "requireKnownIntentCategory": true,
    "allowedCatalogCategories": [
      "crm",
      "marketing",
      "seo",
      "automation",
      "forms",
      "sales",
      "support",
      "social",
      "website",
      "analytics",
      "ai-research",
      "ai-assistant",
      "ai-writing",
      "developer",
      "ecommerce",
      "design",
      "content",
      "business"
    ],
    "allowTrustedEnrichmentFiles": true,
    "autoAdmitTrustedCandidates": true,
    "autoAdmitGeneratedCandidates": false,
    "rejectGenericSyntheticEditorialProfiles": true,
    "maximumFactualReviewAgeDays": 45
  },
  "coverageAdmission": {
    "autoPromoteVerifiedCompetitiveGapProfiles": true,
    "maxPromotionsPerCycle": 5,
    "minimumIndependentMarketSignals": 2,
    "minimumVerifiedCapabilities": 3,
    "minimumDescriptionLength": 60,
    "requireReachableOfficialSource": true,
    "requireKnownCategory": true,
    "rankingEligibleOnAdmission": true,
    "comparisonEligibleOnAdmission": true,
    "requirePricingForCatalogEntry": false,
    "requireToolSpecificScoresForCatalogEntry": false,
    "upgradeToEditorialRequiresSeparateEvidence": false,
    "requireVisualAssetForCatalogEntry": true
  },
  "qualityControl": {
    "enabled": true,
    "volatileFieldReviewDays": 7,
    "stableFieldReviewDays": 30,
    "maxSameOriginEvidencePages": 2,
    "trackFields": [
      "pricing",
      "freePlan",
      "trial",
      "features"
    ],
    "preferFirstPartyVisualAssets": true,
    "validateVisualAssets": true,
    "autoCorrectExplicitFreePlanContradictions": true,
    "autoCorrectInferredFreePlanContradictions": false,
    "pricingChangesRequireEvidenceReview": true,
    "featureChangesRequireEvidenceReview": true,
    "highSeverityFacts": [
      "freePlan",
      "trial",
      "pricing"
    ],
    "reportUnresolvedVisualAssetFailures": true,
    "requireResolvedVisualAssetBeforePublication": true,
    "auditAllPublishedTools": true,
    "runtimeQualityBatchSize": 12,
    "automaticQualityHoldForRuntimeFailures": true
  },
  "trustedCandidateFiles": [
    "data/catalog-wave1-enrichment.json",
    "data/catalog-wave1-enrichment-final.json",
    "data/catalog-wave2-enrichment.json",
    "data/catalog-wave3-enrichment.json"
  ],
  "discovery": {
    "useCompetitiveGapSignals": true,
    "useAffiliatePipelineOnlyAsVendorRegistry": true,
    "affiliateStatusOrCommissionCannotIncreaseSelectionScore": true,
    "minimumIndependentMarketSignals": 2,
    "maxCompetitiveGapProfilesPerCycle": 3,
    "minimumVerifiedCapabilitiesForGapProfile": 2,
    "competitiveGapProfilesAreNonRanking": false,
    "competitiveGapEditorialFactsRequireFirstPartySource": true
  }
}
