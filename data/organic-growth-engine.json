  "thresholds": {
    "minimumCompetitorMentionsForGap": 2,
    "maximumCompetitorUrlsPerSource": 1500,
    "minimumGscImpressionsForCtrAction": 20,
    "strikingDistanceMaxPosition": 20,
    "firstPageMaxPosition": 10
  },
  "backlinkAuthority": {
    "mode": "quality-first",
    "bootstrapReferringDomainFloor": 10,
    "prioritizeObservedDemandAssets": true,
    "vendorReferenceOutreach": true,
    "publisherAndDirectoryPlacements": true,
