{
  "version": 6,
  "principles": {
    "fullyAutonomous": true,
    "ownerContentInterventionRequired": false,
    "commercialIntentBeforeGenericTraffic": true,
    "recurringRevenueFavoredInMonetizationReadiness": true,
    "comparisonsAndDecisionPagesHighValue": true,
    "noAffiliatePayoutEditorialBias": true,
    "noThinProgrammaticPages": true,
    "competitorSignalsAreForGapDetectionOnly": true,
    "copyCompetitorContent": false,
    "realObservedDataBeforeSearchClaims": true,
    "impressionsAreVisibilityNotTraffic": true,
    "strictSemanticEligibility": true,
    "neverFillRankingsWithWrongCategoryTools": true,
    "fewerCorrectRecommendationsBeatMoreIncorrectRecommendations": true,
    "boundedInterventions": true,
    "reversibleExperiments": true,
    "demandLedOptimization": true,
    "legitimateBacklinkAcquisitionPrimarySeoObjective": true,
    "neverBuyRankingLinks": true,
    "neverRequireReciprocalLinks": true,
    "humanAcquisitionIsPrimary": true,
    "activityIsNotSuccess": true,
    "scaleOnlyOnHumanOrCommercialEvidence": true,
    "competitiveAcquisitionGapAlwaysOn": true,
    "resourceBudgetedAlwaysOn": true
  },
  "autonomy": {
    "mode": "closed-loop",
    "ownerRole": "observability-only",
    "cycle": [
      "observe",
      "prioritize",
      "optimize",
      "validate",
      "publish",
      "distribute",
      "measure",
      "learn"
    ],
    "publishOnlyAfterQualityGates": true,
    "insufficientEvidenceAction": "measure-and-recheck-automatically",
    "target": "continuously improve qualified rankings and search clicks without claiming control over Google positions"
  },
  "closedLoop": {
    "maxNewInterventionsPerCycle": 2,
    "minimumDaysBetweenInterventions": 7,
    "minimumEvaluationAgeDays": 14,
    "minimumImpressionsForIntervention": 40,
    "minimumImpressionsForRollback": 100,
    "minimumPositionImprovementForWin": 5,
    "minimumPositionWorseningForRollback": 10,
    "persistActiveVariantUntilMeasured": true,
    "automaticRollbackOnClearLoss": true
  },
  "competitiveGapLoop": {
    "maxNewContentIntentsPerCycle": 1,
    "minimumEligibleToolsForNewContentIntent": 3,
    "minimumParentMatchScore": 3,
    "minimumParentMatchMargin": 1,
    "autoPromoteBestIntentOnly": true,
    "retryHeldCandidatesAutomatically": true
  },
  "editorialGates": {
    "minimumEligibleToolsPerGuide": 2,
    "maximumRankedToolsPerGuide": 3,
    "requireExactIntentCategory": true,
    "minimumLexicalRelevance": 0.75,
    "blockCrossCategoryFallback": true,
    "blockPublicationOnEligibilityFailure": true
  },
