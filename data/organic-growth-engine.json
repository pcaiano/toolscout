    {"name":"G2","baseUrl":"https://www.g2.com","sitemapCandidates":["https://www.g2.com/sitemap.xml"]},
    {"name":"Capterra","baseUrl":"https://www.capterra.com","sitemapCandidates":["https://www.capterra.com/sitemap.xml"]},
    {"name":"Futurepedia","baseUrl":"https://www.futurepedia.io","sitemapCandidates":["https://www.futurepedia.io/sitemap.xml"]},
    {"name":"There's An AI For That","baseUrl":"https://theresanaiforthat.com","sitemapCandidates":["https://theresanaiforthat.com/sitemap.xml"]}
  ],
  "opportunityTerms": ["alternative","alternatives","vs","compare","comparison","best","tools","software","crm","seo","automation","marketing","email","sales","forms","project-management","ai","research","coding","analytics"],
