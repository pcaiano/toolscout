      "interactive_human_verification",
      "mfa",
      "manual_account_creation"
    ],
    "bootstrap_once_then_resume": [
      "account_creation",
      "login",
      "oauth",
      "api_token_provisioning"
    ],
    "human_gate_execution_policy": "non_blocking_sidecar_v2",
    "eligible_surface_policy": "execute_all_qualified_zero_cost_surfaces"
